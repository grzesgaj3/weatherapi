# --- Serwer ---
HOST=127.0.0.1
PORT=8000
DEBUG=false
# Dokumentacja OpenAPI (/docs, /redoc) – domyślnie wyłączona na produkcji.
ENABLE_DOCS=false
# Maks. liczba równoczesnych połączeń (ochrona małego VPS).
LIMIT_CONCURRENCY=50

# --- Baza danych (MySQL/MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=weatherapi
DB_PASS=change-me
DB_NAME=weather_stations
# Mała pula połączeń (jedno stanowisko).
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
# Opcjonalnie: pełne URL-e nadpisujące pola DB_* (np. dla trybu bez MySQL).
# DATABASE_URL=sqlite+aiosqlite:////opt/weatherapi/weather.db
# DATABASE_URL_SYNC=sqlite:////opt/weatherapi/weather.db

# --- Autoryzacja ---
# Sekret administratora (nagłówek X-Admin-Key lub Authorization: Bearer <token>).
# WYMAGANE: min. 16 znaków i nie może być wartością domyślną – inaczej API
# odmówi startu. Wygeneruj np.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me-admin

# Tylko dla testów/dev: zezwala na słaby ADMIN_TOKEN (domyślnie false).
ALLOW_INSECURE_DEFAULTS=false

# --- Limity i cykl życia zleceń ---
RATE_LIMIT_PER_MIN=120
MAX_BODY_BYTES=65536
COMMAND_TTL_MINUTES=60
MAX_ACTIVE_COMMANDS_PER_STATION=1
